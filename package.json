{
  "name": "@arumie/pi-plan-mode",
  "version": "2.0.1",
  "description": "A read-only planning and guided execution mode extension for pi with tool-based step completion",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "plan-mode",
    "planning",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arumie/pi-plan-mode.git"
  },
  "bugs": {
    "url": "https://github.com/arumie/pi-plan-mode/issues"
  },
  "homepage": "https://github.com/arumie/pi-plan-mode#readme",
  "files": [
    "extensions/plan-mode/index.ts",
    "extensions/plan-mode/utils.ts",
    "extensions/plan-mode/runtime/runtime.ts",
    "extensions/plan-mode/runtime/tools.ts",
    "extensions/plan-mode/runtime/commands.ts",
    "extensions/plan-mode/runtime/execution-preflight.ts",
    "extensions/plan-mode/runtime/lifecycle-hooks.ts",
    "extensions/plan-mode/runtime/message-utils.ts",
    "extensions/plan-mode/security/tool-policy.ts",
    "extensions/plan-mode/security/command-safety.ts",
    "extensions/plan-mode/plan/types.ts",
    "extensions/plan-mode/plan/settings.ts",
    "extensions/plan-mode/plan/paths.ts",
    "extensions/plan-mode/plan/frontmatter.ts",
    "extensions/plan-mode/plan/content.ts",
    "extensions/plan-mode/plan/files.ts",
    "extensions/plan-mode/plan/widget.ts",
    "extensions/plan-mode/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types extensions/plan-mode/utils.test.ts && node --experimental-strip-types test/package-manifest.test.ts && node --experimental-strip-types test/save-plan-tool.test.ts && node --experimental-strip-types test/plan-list.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm test && npm run typecheck && npm run pack:check"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions/plan-mode/index.ts"
    ]
  }
}
